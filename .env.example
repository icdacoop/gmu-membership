# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# 구글 시트 연동 (google-apps-script/README.md 참고) — 이 사이트 전용으로 새로 만든 값
GOOGLE_SCRIPT_URL=
APPLY_TOKEN=

# 계좌이체(무통장입금) 안내에 보여 줄 입금 계좌 — 세 값이 모두 있어야 화면에 표시됩니다.
# 비어 있으면 "입금 계좌는 이메일·전화로 안내드리겠습니다"라는 문구가 대신 나옵니다.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# 카드 결제 (건흥페이먼츠 PG, "올고") — PG_PUBLIC_KEY 가 있어야 카드 결제가 열립니다. 비어 있으면 카드는 "준비 중"입니다.
# 결제키는 PG 에서 받은 값을 .env.local / Vercel 환경변수에만 넣고, 채팅·코드·문서에는 적지 않습니다.
PG_PUBLIC_KEY=            # 결제창 호출용 온라인 결제키 (pk_…)
PG_SECRET_KEY=            # (선택) 서버 호출(승인·조회)용 키. 비우면 PG_PUBLIC_KEY 를 Authorization 에 그대로 사용
PG_ENV=sandbox            # sandbox(테스트) 또는 live(운영). 운영 결제를 열 때만 live 로 바꿉니다
PG_WEBHOOK_TOKEN=         # (권장) 웹훅 주소 비밀 토큰. PG 에는 .../api/payment/webhook?k=<이 값> 으로 등록
PG_WEBHOOK_IPS=           # (선택) 웹훅을 보낼 수 있는 PG 서버 IP 목록(쉼표 구분)
# PG_API_BASE=            # (선택) PG API 주소를 바꿀 때만. 기본: sandbox=https://devapi.ghpayments.kr, live=https://api.ghpayments.kr
